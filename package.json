{
  "name": "watchtower",
  "productName": "Watchtower",
  "version": "1.0.0",
  "description": "See what your PC is secretly doing: who used your mic, camera and location, and where your data goes.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env WATCHTOWER_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "shortcut": "node scripts/make-shortcut.cjs",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.27.2",
    "three": "0.187.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "world-atlas": "^2.0.2"
  },
  "author": "AsadbekB-Dev",
  "homepage": "https://github.com/AsadbekB-Dev/watchtower",
  "build": {
    "appId": "dev.asadbek.watchtower",
    "productName": "Watchtower",
    "copyright": "Built at HackCC 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "electron/scripts/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Watchtower",
      "artifactName": "Watchtower-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
